# App settings (never commit .env). Every key is optional: the defaults are shown.
# Locally, devkit's "deploy.sh local" creates .env from this file. Deploying from GitHub, each
# key comes from a secret or variable named DEPLOY_<KEY> (the "env" input of the deploy job in
# .github/workflows/ci-cd.yml); on the server, devkit sets DATA_DIR, FRONTEND_DIST and
# PUBLIC_URL (from the domain) by itself.

# Address shown in the download window for bug reports and feedback (optional).
CONTACT_EMAIL=

# Salt for the anonymised ids in the server log. Random per run when empty; on the server
# devkit generates one on the first deploy and keeps it.
LOG_HASH_SALT=

# Abuse protection (per client IP). A panel retouch counts like a generation.
RATE_API_PER_MINUTE=120
RATE_GENERATE_PER_MINUTE=4
RATE_GENERATE_PER_DAY=100
MAX_JOBS_PER_CLIENT=1
MAX_CONCURRENT_JOBS=4
AUTH_FAILURES_BEFORE_LOCK=5
AUTH_FAILURE_WINDOW_S=900
AUTH_LOCK_S=1800
# Finished generations and retouches (and their image) are dropped from memory after this.
JOB_TTL_S=900
MAX_STORED_JOBS=64

# Development only: keep every job's request (final prompt, parameters; never the key), the
# images sent, the model's raw answer and what the browser made of it, in this folder (e.g.
# data/debug). Leave it empty in production: it is ignored anyway whenever PUBLIC_URL is set,
# as on the server, so no image is ever kept there.
DEBUG_DUMP_DIR=

# Development only: a simulated image model. Generations and retouches get test images made
# by the server, instantly and for free; no provider is called and no API key is needed. Set
# it to 1 to work on the UI (panels, retouch window, blend, undo/redo) without spending. Ignored
# whenever PUBLIC_URL is set, as on the server.
DEBUG_FAKE_MODEL=
