# Copy to .env on the server (never commit .env). Deploying from GitHub, every
# key can instead be set as a secret or variable named DEPLOY_<KEY> in the
# "vars" environment: deploy.sh then creates/updates .env from them.

# Domain of this app. Caddy (already on the server) gets its HTTPS certificate.
SITE_ADDRESS=example.com
# Optional: public URL sent to OpenRouter as the app's referer.
PUBLIC_URL=https://example.com

# Local port of the app (it listens on 127.0.0.1 only). Change it if another
# app on the server already uses it.
APP_PORT=8787
# Main Caddy config that imports this app's site block (storygapboard.caddy).
CADDYFILE=/etc/caddy/Caddyfile

# Salt for the anonymised ids in the server log. ./deploy.sh production
# generates one automatically if this is empty.
LOG_HASH_SALT=

# Abuse protection (per client IP). Defaults shown.
RATE_API_PER_MINUTE=120
RATE_GENERATE_PER_MINUTE=4
RATE_GENERATE_PER_DAY=100
MAX_JOBS_PER_CLIENT=1
MAX_CONCURRENT_JOBS=4
AUTH_FAILURES_BEFORE_LOCK=5
AUTH_FAILURE_WINDOW_S=900
AUTH_LOCK_S=1800
# Finished generations (and their image) are dropped from memory after this.
JOB_TTL_S=900
MAX_STORED_JOBS=64
